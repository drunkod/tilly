# Jazz/CoValues Configuration
PUBLIC_JAZZ_SYNC_SERVER=wss://cloud.jazz.tools/?key=YOUR_KEY
PUBLIC_JAZZ_WORKER_ACCOUNT=
JAZZ_WORKER_SECRET=

# AI Configuration (optional for static builds)
GOOGLE_AI_API_KEY=

# Push Notifications (optional for static builds)
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Budget & Billing (optional for static builds)
WEEKLY_BUDGET=
PUBLIC_ENABLE_PAYWALL=false
INPUT_TOKEN_COST_PER_MILLION=
CACHED_INPUT_TOKEN_COST_PER_MILLION=
OUTPUT_TOKEN_COST_PER_MILLION=
MAX_REQUEST_TOKENS=

# Analytics (optional)
PUBLIC_PLAUSIBLE_DOMAIN=

# Server URL for static builds (optional)
PUBLIC_SERVER_URL=

# Deployment Configuration
# For GitHub Pages: set GITHUB_PAGES_BASE=username.github.io/repo-name
# For self-hosting with base path: set ASTRO_BASE_PATH=/your-path
# For self-hosting at root: leave both unset
# GITHUB_PAGES_BASE=drunkod.github.io/tilly
# ASTRO_BASE_PATH=/tilly
# PUBLIC_SITE_URL=https://yourdomain.com