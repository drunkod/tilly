---
import "#app/index.css"
import { Navbar } from "#www/components/Navbar"
import { Footer } from "#www/components/Footer"

export interface Props {
	title: string
	description?: string
	locale?: "en" | "de" | "ru"
}

let { title, description, locale = "en" } = Astro.props
let baseUrl = import.meta.env.BASE_URL
let requestUrl = new URL(Astro.request.url)
let siteBaseUrl = Astro.site ?? new URL(requestUrl.origin)
let canonicalUrl = new URL(
	requestUrl.pathname + requestUrl.search,
	siteBaseUrl,
).toString()
let ogImageUrl = new URL("/og.png", siteBaseUrl).toString()
let metaDescription = description ?? ""

// Localized navigation
let localizedNav =
	locale === "de"
		? {
				home: `${baseUrl}de/`,
				features: `${baseUrl}de/#features`,
				pricing: `${baseUrl}de/#pricing`,
				faq: `${baseUrl}de/#faq`,
				blog: `${baseUrl}de/blog`,
				imprint: `${baseUrl}de/imprint`,
				privacy: `${baseUrl}de/privacy`,
				labels: {
					features: "Funktionen",
					pricing: "Tarife",
					faq: "FAQ",
					blog: "Blog",
					imprint: "Impressum",
					privacy: "Datenschutz",
					goToApp: "Zur App",
				},
			}
		: locale === "ru"
			? {
					home: `${baseUrl}ru/`,
					features: `${baseUrl}ru/#features`,
					pricing: `${baseUrl}ru/#pricing`,
					faq: `${baseUrl}ru/#faq`,
					blog: `${baseUrl}ru/blog`,
					imprint: `${baseUrl}ru/imprint`,
					privacy: `${baseUrl}ru/privacy`,
					labels: {
						features: "Возможности",
						pricing: "Цены",
						faq: "FAQ",
						blog: "Блог",
						imprint: "Выходные данные",
						privacy: "Конфиденциальность",
						goToApp: "Перейти к приложению",
					},
				}
			: {
					home: `${baseUrl}en/`,
					features: `${baseUrl}en/#features`,
					pricing: `${baseUrl}en/#pricing`,
					faq: `${baseUrl}en/#faq`,
					blog: `${baseUrl}en/blog`,
					imprint: `${baseUrl}en/imprint`,
					privacy: `${baseUrl}en/privacy`,
					labels: {
						features: "Features",
						pricing: "Pricing",
						faq: "FAQ",
						blog: "Blog",
						imprint: "Imprint",
						privacy: "Privacy",
						goToApp: "Go to App",
					},
				}
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body class="min-h-screen bg-background text-foreground">
		<Navbar
			locale={locale}
			baseUrl={import.meta.env.BASE_URL}
			client:load
			logo={{
				text: "Tilly",
				href: localizedNav.home,
			}}
		navigation={[
			{ name: localizedNav.labels.features, href: localizedNav.features },
			{ name: localizedNav.labels.pricing, href: localizedNav.pricing },
			{ name: localizedNav.labels.faq, href: localizedNav.faq },
			{ name: localizedNav.labels.blog, href: localizedNav.blog },
		]}
			cta={{
				text: localizedNav.labels.goToApp,
				href: `${import.meta.env.BASE_URL}app`,
			}}
			languages={[
				{ name: "English", href: `${baseUrl}en/` },
				{ name: "Deutsch", href: `${baseUrl}de/` },
				{ name: "Русский", href: `${baseUrl}ru/` },
			]}
		/>

		<main class="mx-auto max-w-4xl px-6 py-24">
			<div class="prose prose-gray max-w-none dark:prose-invert">
				<slot />
			</div>
		</main>
		<Footer
		navigation={{
			main: [
				{ name: localizedNav.labels.features, href: localizedNav.features },
				{ name: localizedNav.labels.pricing, href: localizedNav.pricing },
				{ name: localizedNav.labels.faq, href: localizedNav.faq },
				{ name: localizedNav.labels.blog, href: localizedNav.blog },
				{ name: localizedNav.labels.imprint, href: localizedNav.imprint },
				{ name: localizedNav.labels.privacy, href: localizedNav.privacy },
			],
				social: [
					{ name: "Twitter", href: "#", icon: "Twitter" },
					{ name: "GitHub", href: "#", icon: "Github" },
				],
				languages: [
					{ name: "English", href: `${baseUrl}en/` },
					{ name: "Deutsch", href: `${baseUrl}de/` },
					{ name: "Русский", href: `${baseUrl}ru/` },
				],
			}}
			company={{
				name: "Tilly",
			}}
		/>
	</body>
</html>

<style>
	html {
		font-family: system-ui, sans-serif;
	}
</style>
