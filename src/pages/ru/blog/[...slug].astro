---
import MinimalMarketingLayout from "#www/layouts/MinimalMarketingLayout.astro"
import { Navbar } from "#www/components/Navbar"
import { Footer } from "#www/components/Footer"
import { getCollection, render } from "astro:content"

export const prerender = true

export async function getStaticPaths() {
	let posts = await getCollection("blog")
	let ruPosts = posts.filter(post => post.id.endsWith("/ru"))

	return ruPosts.map(post => ({
		params: { slug: post.id.replace("/ru", "") },
		props: { post },
	}))
}

let { post } = Astro.props
if (!post) {
	throw new Error(`Post not found in props. Slug: ${Astro.params.slug}`)
}
let { Content } = await render(post)
let baseUrl = import.meta.env.BASE_URL
---

<MinimalMarketingLayout
	title={`${post.data.title} - Tilly Блог`}
	description={post.data.description}
	ogImage={post.data.ogImage}
>
	<Navbar
		locale="ru"
		baseUrl={import.meta.env.BASE_URL}
		client:load
		logo={{
			text: "Tilly",
			href: `${baseUrl}ru/`,
		}}
		navigation={[
			{ name: "Возможности", href: `${baseUrl}ru/#features` },
			{ name: "Опыт", href: `${baseUrl}ru/#experience` },
			{ name: "FAQ", href: `${baseUrl}ru/#faq` },
			{ name: "Блог", href: `${baseUrl}ru/blog` },
		]}
		cta={{
			text: "Перейти к приложению",
			href: `${import.meta.env.BASE_URL}app`,
		}}
		languages={[
			{ name: "English", href: `${baseUrl}en/blog/${post.id.replace("/ru", "")}` },
			{ name: "Deutsch", href: `${baseUrl}de/blog/${post.id.replace("/ru", "")}` },
			{ name: "Русский", href: `${baseUrl}ru/blog/${post.id.replace("/ru", "")}` },
		]}
	/>

	<main class="container mx-auto px-6 py-12 md:px-8 md:py-24">
		<article class="prose prose-lg dark:prose-invert mx-auto max-w-3xl">
			<div class="not-prose mb-8">
				<a
					href={`${baseUrl}ru/blog`}
					class="text-muted-foreground hover:text-foreground mb-4 inline-block text-sm transition-colors"
				>
					← Вернуться к блогу
				</a>
				<h1 class="text-4xl font-bold tracking-tight md:text-5xl">
					{post.data.title}
				</h1>
				<p class="text-muted-foreground mt-4 text-lg">
					{post.data.description}
				</p>
				<div class="mt-4 flex items-center gap-4 text-sm">
					<time class="text-muted-foreground">
						{post.data.pubDate}
					</time>
					<div class="flex gap-2">
						{post.data.tags.map(tag => (
							<span class="bg-muted text-muted-foreground rounded px-2 py-1 text-xs">
								{tag}
							</span>
						))}
					</div>
				</div>
				<div class="mt-6 flex items-center gap-3 border-t pt-6">
					<img
						src={`${baseUrl}${post.data.author.avatar.replace(/^\//, "")}`}
						alt={post.data.author.name}
						class="h-12 w-12 rounded-full object-cover"
					/>
					<div>
						<p class="font-medium">
							{post.data.author.name}
						</p>
						<p class="text-muted-foreground text-sm">
							{post.data.author.role}
						</p>
					</div>
				</div>
			</div>

			<Content />
		</article>
	</main>

	<Footer
		navigation={{
			main: [
				{ name: "Возможности", href: `${baseUrl}ru/#features` },
				{ name: "Опыт", href: `${baseUrl}ru/#experience` },
				{ name: "FAQ", href: `${baseUrl}ru/#faq` },
				{ name: "Блог", href: `${baseUrl}ru/blog` },
				{ name: "Выходные данные", href: `${baseUrl}ru/imprint` },
				{ name: "Конфиденциальность", href: `${baseUrl}ru/privacy` },
			],
			social: [
				{
					name: "Twitter",
					href: "https://twitter.com/tillydotsocial",
					icon: "Twitter",
				},
				{
					name: "Instagram",
					href: "https://instagram.com/tilly.social",
					icon: "Instagram",
				},
				{
					name: "GitHub",
					href: "https://github.com/ccssmnn/tilly",
					icon: "Github",
				},
			],
			languages: [
				{ name: "English", href: `${baseUrl}en/blog` },
				{ name: "Deutsch", href: `${baseUrl}de/blog` },
				{ name: "Русский", href: `${baseUrl}ru/blog` },
			],
		}}
		company={{
			name: "Tilly",
		}}
	/>
</MinimalMarketingLayout>
