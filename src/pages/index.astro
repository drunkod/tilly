---
import { getPreferredLocale } from "#middleware"

// Get base URL from Astro (includes base path)
const baseUrl = import.meta.env.BASE_URL || "/"

// Server-side locale detection for redirect (works in SSR, ignored in static build)
if (Astro.request.headers) {
  const acceptLanguage = Astro.request.headers.get("accept-language")
  const locale = getPreferredLocale(acceptLanguage)
  return Astro.redirect(`${baseUrl}${locale}/`, 301)
}
---

<!DOCTYPE html>
<html lang="en" class="overscroll-y-none bg-background">
  <head>
    <title>Tilly - Personal Relation Helper</title>
    <meta
      name="description"
      content="remember what's important and stay in touch with your friends and loved ones."
    />
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
    <link rel="canonical" href={Astro.site} />
    <meta
      name="viewport"
      content="initial-scale=1, viewport-fit=cover, width=device-width, user-scalable=no"
    />
    <meta property="og:title" content="Tilly - Personal Relation Helper" />
    <meta
      property="og:description"
      content="remember what's important and stay in touch with your friends and loved ones."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString()} />
    <meta property="og:image" content={`${Astro.site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tilly - Personal Relation Helper" />
    <meta
      name="twitter:description"
      content="remember what's important and stay in touch with your friends and loved ones."
    />
    <meta name="twitter:image" content={`${Astro.site}og.png`} />
    <script define:vars={{ baseUrl }}>
      // Client-side redirect for static hosting (GitHub Pages)
      let targetLang = 'en';
      try {
        const userLang = (navigator.language || navigator.userLanguage).slice(0, 2);
        if (userLang === 'de' || userLang === 'ru') {
          targetLang = userLang;
        }
      } catch (e) {
        console.error('Language detection failed, falling back to English.', e);
      }
      window.location.replace(`${baseUrl}${targetLang}/`);
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div class="flex min-h-screen flex-col items-center justify-center gap-8">
      <img
        src={`${baseUrl}app/icons/icon-192x192.png`}
        class="h-24 w-24 rounded-lg"
        alt="Tilly icon"
      />
      <h1 class="text-3xl font-semibold">Tilly</h1>
      <div class="flex flex-col gap-3">
        <a
          href={`${baseUrl}en/`}
          class="rounded-lg bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/90"
        >
          Continue in English 🇺🇸
        </a>
        <a
          href={`${baseUrl}de/`}
          class="rounded-lg bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/90"
        >
          Weiter auf Deutsch 🇩🇪
        </a>
        <a
          href={`${baseUrl}ru/`}
          class="rounded-lg bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/90"
        >
          Продолжить на русском 🇷🇺
        </a>
      </div>
    </div>
  </body>
</html>